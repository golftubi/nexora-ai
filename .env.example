# Neon PostgreSQL — server-only pooled connection string
DATABASE_URL=

# Better Auth — generate a random secret of at least 32 characters
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public application origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel AI Gateway
AI_GATEWAY_MODEL=openai/gpt-5.4

# Comma-separated email allowlist for the restricted Security & Intelligence assistant
NEXORA_SECURITY_ADMIN_EMAILS=
